# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/videoApp?retryWrites=true&w=majority

# CORS Configuration (Set to your Vercel Frontend URL)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Security Configuration (Generate a strong random secret key)
JWT_SECRET=your_super_secret_jwt_key_here
